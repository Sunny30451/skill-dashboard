{
  "name": "social-campaign-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{src,server}/**/*.{ts,tsx,css}\" \"*.{ts,json,html,md}\"",
    "format:check": "prettier --check \"{src,server}/**/*.{ts,tsx,css}\" \"*.{ts,json,html,md}\"",
    "start": "node server-dist/server/index.js --production",
    "preview": "npm run start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "busboy": "^1.6.0",
    "cron-parser": "^5.8.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
