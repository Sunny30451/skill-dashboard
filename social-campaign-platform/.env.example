# Copy to .env for local Compose, or enter the values in Dokploy's Environment UI.
# Never commit a populated .env file.

# Public application URL, without a trailing slash. Production requires HTTPS.
PUBLIC_BASE_URL=https://campaign.example.com

# Required secrets. Generate independent random values; do not reuse them.
POSTGRES_DB=campaignhub
POSTGRES_USER=campaignhub
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=campaignhub
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-password
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes-in-base64

# First start only: the admin is created only while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=CampaignHub Admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
ALLOW_REGISTRATION=false
SESSION_TTL_SECONDS=1209600
WORKER_ENABLED=true

# Object storage
# Public HTTPS S3 API used in short-lived signed browser/provider media URLs.
# Route this hostname to service `minio`, port 9000, in Dokploy's Domains UI.
S3_ENDPOINT=https://media.campaign.example.com
S3_REGION=us-east-1
S3_BUCKET=campaignhub-media
MAX_UPLOAD_BYTES=536870912

# Optional SMTP. Set SMTP_HOST and SMTP_FROM together to enable mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# YouTube / Google OAuth and WebSub
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_WEBHOOK_SECRET=
YOUTUBE_WEBSUB_VERIFY_TOKEN=

# Meta (Facebook Login for Business, Facebook Pages, Instagram professional)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# TikTok Login Kit, Display API and Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_WEBHOOK_SECRET=

# Optional self-hosted Ollama profile
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ALLOWED_HOSTS=ollama
OLLAMA_REQUEST_TIMEOUT_MS=120000
